rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Trust Security Policy:
    // Seluruh akses dari Firebase Client SDK (browser/mobile) ditutup 100%.
    // Semua operasi baca dan tulis wajib melewati server Next.js via Firebase Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
